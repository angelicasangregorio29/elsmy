# Environment variables template for ELSMY server

# Port to listen on (default 3000 for local development)
PORT=3000

# Environment: development or production
NODE_ENV=development

# Upload directory (defaults to ./uploads if not set)
UPLOAD_DIR=./server/uploads

# Max upload file size in MB (default 50)
MAX_UPLOAD_SIZE=50

# CORS origin for frontend (set to your frontend URL in production)
CORS_ORIGIN=*
